# All variables are SERVER-ONLY. Do not add NEXT_PUBLIC_ prefixes.
FHQ_API_URL=http://127.0.0.1:8010
FHQ_API_TOKEN=replace-with-the-same-private-backend-token
FHQ_ACCESS_USERNAME=replace-with-private-preview-username
FHQ_ACCESS_PASSWORD=replace-with-at-least-20-random-characters
# Local development only. Production backend URL must use HTTPS.
FHQ_ALLOW_LOCAL_API=1
# Exact frontend origin for mutation/CSRF checks; set your real Vercel URL there.
FHQ_FRONTEND_ORIGIN=http://localhost:3000
